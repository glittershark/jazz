	(gr_text "CR(nausicaa): added more via pinning up\nhere, as well as in some locations lower\ndown to improve flow in GND."
		(at 144.78 31.115 0)
		(layer "Cmts.User")
		(uuid "1d0d36ef-0670-4b7b-a5b1-4ff7110762c0")
		(effects
			(font
				(size 0.2 0.2)
				(thickness 0.01)
			)
			(justify left bottom)
		)
	)
	(gr_text "CR(nausicaa): used L to toggle locking for all\nthe stuff that's position-sensitive. forgot that\nwas a thing, but it's the fastest way of keeping\nthings from moving."
		(at 160.02 45.72 0)
		(layer "Cmts.User")
		(uuid "4e6fdf13-40f0-4aac-9d0c-9526e4fa8069")
		(effects
			(font
				(size 0.5 0.5)
				(thickness 0.05)
			)
			(justify left bottom)
		)
	)
	(gr_text "CR(nausicaa): there are some silkscreen\ncutoffs. up to you where you want to \nmove the text (if at all)."
		(at 160.02 50.8 0)
