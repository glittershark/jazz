	(text "the daisy seed has 100 Ω of output\nimpedance, so a 33 nF capacitor here\ngives a lowpass knee of about 48 kHz."
		(exclude_from_sim yes)
		(at 13.208 121.666 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "05422889-e28f-4f8c-a7c2-134d41c3e80e")
	)
	(text "this switch cuts out the output audio \namplifiers. since the TL072s run from\nVCC (at least 9 V), they won't get \npower if we're running this pedal from\nUSB. flipping this switch allows us\nto use the daisy's audio out lines \ndirectly in that case."
		(exclude_from_sim yes)
		(at 123.698 89.662 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3a215fdf-f44e-4730-8627-a3814edb579a")
	)
	(text "i (nausicaa) am 100% sure that, \ngiven a capacitively-coupled \ninput, the input to this inverting\namplifier will self-reference to \nAMP_REF."
		(exclude_from_sim yes)
		(at 15.494 87.376 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "714f64b6-cf4e-4317-b769-3b37d42297d0")
	)
	(text "~1.1 s time constant, will take \naround 2 s to start up fully"
		(exclude_from_sim no)
		(at 63.754 206.756 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "858599ab-3e9e-47b2-8e13-8a12b279d0c3")
	)
